{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commerce-refund-response.schema.json",
  "title": "CommerceRefundResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "service", "trace_id", "request_id", "refund_id", "order_id", "checkout_id", "status", "amount", "currency"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "refund_id": { "type": "string", "minLength": 1 },
    "order_id": { "type": "string", "minLength": 1 },
    "checkout_id": { "type": "integer", "minimum": 1 },
    "user_id": { "type": ["string", "null"] },
    "payment_id": { "type": ["string", "null"] },
    "inventory_reservation_id": { "type": ["string", "null"] },
    "status": { "type": "string", "minLength": 1 },
    "reason": { "type": "string" },
    "amount": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "error_code": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/refundItem" }
    },
    "payment_cancellation": { "type": "object", "additionalProperties": true },
    "inventory_release": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "refundItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_id", "quantity", "amount"],
      "properties": {
        "book_id": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1 },
        "amount": { "type": "number", "minimum": 0 }
      }
    }
  }
}
