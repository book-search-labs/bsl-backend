{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commerce-checkout-list-response.schema.json",
  "title": "CommerceCheckoutListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "service", "trace_id", "request_id", "items", "count", "limit", "mode"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkoutSummary" }
    },
    "count": { "type": "integer", "minimum": 0 },
    "status_filter": { "type": ["string", "null"] },
    "limit": { "type": "integer", "minimum": 1 },
    "mode": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "checkoutSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkout_id", "checkout_key", "user_id", "status", "steps", "failed_steps", "outbox_event_count"],
      "properties": {
        "checkout_id": { "type": "integer", "minimum": 1 },
        "checkout_key": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "current_step": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] },
        "saga_version": { "type": "integer", "minimum": 0 },
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/stepSummary" } },
        "failed_steps": { "type": "array", "items": { "$ref": "#/$defs/stepSummary" } },
        "outbox_event_count": { "type": "integer", "minimum": 0 }
      }
    },
    "stepSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_name", "status", "step_category", "recovery_policy", "retry_count", "max_retry_count"],
      "properties": {
        "step_name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "step_category": { "type": "string", "minLength": 1 },
        "recovery_policy": { "type": "string", "minLength": 1 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "max_retry_count": { "type": "integer", "minimum": 0 },
        "next_retry_at": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      }
    }
  }
}
