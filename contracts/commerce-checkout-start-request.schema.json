{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commerce-checkout-start-request.schema.json",
  "title": "CommerceCheckoutStartRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkout_key", "user_id", "items", "payment", "shipping_address"],
  "properties": {
    "checkout_key": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkoutItem" }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "shipping_address": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    },
    "currency": { "type": "string", "minLength": 1 },
    "total_amount": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "checkoutItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_id", "quantity"],
      "properties": {
        "book_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unit_price": { "type": "number", "minimum": 0 }
      }
    }
  }
}
